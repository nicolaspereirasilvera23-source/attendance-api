// Schema de desarrollo local (SQLite).
// Uso: DATABASE_URL="file:./prisma/dev.db" npm run prisma:sqlite
// Nota: SQLite no soporta enums nativos de Prisma, por eso `staffType`
// y `status` son String. El proveedor canónico (PostgreSQL/Supabase) es
// prisma/schema.prisma.
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String  @id @default(uuid())
  email     String  @unique
  password  String
  name      String
  role      String  @default("COACH")
  staffType String  @default("ADMINISTRATIVO")
  squad     String?
  active    Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tasks     Task[]

  @@index([squad])
}

model Player {
  id          String       @id @default(uuid())
  code        String       @unique
  name        String
  age         Int
  timeInClub  Int
  squad       String       @default("Masculino A")
  active      Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  attendances Attendance[]

  @@index([squad])
}

model Attendance {
  id        String   @id @default(uuid())
  playerId  String
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  date      DateTime @default(now())
  createdAt DateTime @default(now())
}

model Task {
  id          String   @id @default(uuid())
  title       String
  description String?
  status      String   @default("TODO")
  category    String   @default("GENERAL")
  priority    String   @default("MEDIUM")
  dueDate     DateTime?
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([category])
}

model Event {
  id          String   @id @default(uuid())
  title       String
  description String?
  startDate   DateTime
  endDate     DateTime
  location    String?
  category    String   @default("MATCH")
  createdAt   DateTime @default(now())
}
